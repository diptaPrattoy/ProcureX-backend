NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Neon PostgreSQL
# Runtime/API traffic should use Neon's pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require"
# Prisma CLI/migrations should use the direct connection string.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"
# Prisma / Neon runtime pool settings
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=60000
DB_TRANSACTION_MAX_WAIT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=15000

# Browser clients allowed to call the API. Comma-separate multiple origins.
CORS_ORIGINS=http://localhost:3000
CLIENT_APP_URL=http://localhost:3000

# ProcuraX JWT/session settings
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=procurax-api
JWT_AUDIENCE=procurax-client

# Google Identity Services. Create a Web OAuth client in Google Cloud Console.
# The frontend will send the returned Google ID token/credential to ProcuraX.
GOOGLE_CLIENT_ID=

# One-time auth token lifetimes
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# Email delivery. "console" prints development links to the API terminal.
# Change to "smtp" when you are ready to use a real mail provider.
EMAIL_DELIVERY_MODE=console
MAIL_FROM_NAME=ProcuraX
MAIL_FROM_EMAIL=no-reply@procurax.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional seeded ADMIN account. Used only by `npm run db:seed`.
# Do not commit real credentials.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=ProcuraX
SEED_ADMIN_LAST_NAME=Admin
