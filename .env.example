NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Neon PostgreSQL
# Runtime should use the pooled (-pooler) URL; Prisma migrations use the direct URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=60000
DB_TRANSACTION_MAX_WAIT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=15000

# Frontend / CORS
CORS_ORIGINS=http://localhost:3000
CLIENT_APP_URL=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=procurax-api
JWT_AUDIENCE=procurax-client

# Google Identity Services
GOOGLE_CLIENT_ID=

# Email
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_DELIVERY_MODE=console
MAIL_FROM_NAME=ProcuraX
MAIL_FROM_EMAIL=no-reply@procurax.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/payments/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/payments/cancel

# Upstash Redis cache
CACHE_ENABLED=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_CATEGORY_TTL_SECONDS=600
CACHE_SUPPLIER_TTL_SECONDS=120
CACHE_ANALYTICS_TTL_SECONDS=30

# Distributed rate limiting (uses Upstash on production/Vercel; memory fallback locally)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_GLOBAL_LIMIT=300
RATE_LIMIT_AUTH_LIMIT=10

# Optional local seed credentials. Do not use these example values in production.
SEED_ADMIN_EMAIL=admin@procurax.local
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_ADMIN_FIRST_NAME=ProcuraX
SEED_ADMIN_LAST_NAME=Admin
