NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Neon runtime connection: use the POOLED connection string (-pooler in hostname).
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon CLI/migration connection: use the DIRECT (non-pooler) connection string.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"

# Comma-separated origins. Add the frontend deployment URL later.
CORS_ORIGINS=http://localhost:3000

# Generate your own secret. Example:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=procurax-api
JWT_AUDIENCE=procurax-client
