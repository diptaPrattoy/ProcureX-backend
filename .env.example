NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=verify-full
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=60000
DB_TRANSACTION_MAX_WAIT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=15000

CORS_ORIGINS=http://localhost:3000
CLIENT_APP_URL=http://localhost:3000

JWT_ACCESS_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=procurax-api
JWT_AUDIENCE=procurax-client

GOOGLE_CLIENT_ID=

EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_DELIVERY_MODE=console
MAIL_FROM_NAME=ProcuraX
MAIL_FROM_EMAIL=no-reply@procurax.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Stripe test-mode credentials. Keep real values only in .env / deployment secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/payments/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/payments/cancel

SEED_ADMIN_EMAIL=admin@procurax.local
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_ADMIN_FIRST_NAME=ProcuraX
SEED_ADMIN_LAST_NAME=Admin
